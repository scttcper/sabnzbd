{
  "name": "@ctrl/sabnzbd",
  "version": "0.0.0-placeholder",
  "description": "TypeScript api wrapper for SABnzbd using ofetch",
  "keywords": [
    "sabnzbd",
    "typescript"
  ],
  "homepage": "https://sabnzbd.ep.workers.dev",
  "license": "MIT",
  "author": "Scott Cooper <scttcper@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scttcper/sabnzbd.git"
  },
  "files": [
    "dist/src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "oxfmt --check && oxlint .",
    "lint:fix": "oxfmt && oxlint . --fix",
    "prepare": "npm run build",
    "build": "tsc",
    "build:docs": "node --import ./typedoc.mjs ./node_modules/typedoc/bin/typedoc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ctrl/shared-usenet": "^1.0.2",
    "node-fetch-native": "^1.6.7",
    "ofetch": "^1.5.1",
    "type-fest": "^5.10.0",
    "ufo": "^1.6.4"
  },
  "devDependencies": {
    "@ctrl/oxlint-config": "1.5.0",
    "@sindresorhus/tsconfig": "8.1.0",
    "@types/node": "26.6.4",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typedoc": "0.28.20",
    "typescript": "7.0.2",
    "typescript6": "npm:typescript@6.0.3",
    "vitest": "5.0.3"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.9.1"
}
